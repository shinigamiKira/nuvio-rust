#define VER_FILEVERSION 0,1,0,0
#define VER_FILEVERSION_STR "0.1.0.0"

1 ICON "nuvio.ico"

1 VERSIONINFO
FILEVERSION VER_FILEVERSION
PRODUCTVERSION VER_FILEVERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nuvio (unofficial Windows port)"
            VALUE "FileDescription", "Nuvio"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "nuvio"
            VALUE "LegalCopyright", "GPL-3.0-only"
            VALUE "OriginalFilename", "nuvio.exe"
            VALUE "ProductName", "Nuvio"
            VALUE "ProductVersion", VER_FILEVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
